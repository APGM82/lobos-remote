# Dockerfile específico para el servicio Reverb
# Basado en el Dockerfile principal pero optimizado para Reverb

FROM php:8.2-fpm

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y \
    git unzip curl libonig-dev libzip-dev zip netcat-openbsd \
    && docker-php-ext-install pdo pdo_mysql mbstring zip pcntl

# Instalar Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Crear directorio de la app
WORKDIR /var/www/html

# Copiar archivos de Laravel
COPY . .

# Instalar dependencias de PHP
# Si existe composer.lock, usarlo; si no, instalar y generar uno
RUN if [ -f composer.lock ]; then \
        composer install --no-dev --optimize-autoloader; \
    else \
        composer install --optimize-autoloader && \
        composer update --optimize-autoloader; \
    fi

# Copiar .env.example a .env si no existe .env
RUN if [ ! -f ".env" ]; then \
        if [ -f ".env.example" ]; then \
            cp .env.example .env; \
        fi; \
    fi

# Generar APP_KEY si no existe
RUN if ! grep -q "APP_KEY=base64:" .env 2>/dev/null; then \
        php artisan key:generate --force || true; \
    fi

# Dar permisos de ejecución al entrypoint de Reverb
COPY entrypoint-reverb.sh /entrypoint-reverb.sh
RUN chmod +x /entrypoint-reverb.sh && sed -i 's/\r$//' /entrypoint-reverb.sh

# Exponer puerto de Reverb
EXPOSE 8080

# Usar el entrypoint específico de Reverb
ENTRYPOINT ["sh", "/entrypoint-reverb.sh"]

