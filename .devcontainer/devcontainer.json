{
  "name": "Lobos de Castronegro",
  "dockerComposeFile": "../docker-compose.yaml",
  "service": "frontend",
  "workspaceFolder": "/app",
  "forwardPorts": [5173, 8000, 8080, 3306],
  "portsAttributes": {
    "5173": { "label": "Frontend (Vite)" },
    "8000": { "label": "Backend (Laravel)" },
    "8080": { "label": "WebSocket (Reverb)" },
    "3306": { "label": "MySQL" }
  },
  "postStartCommand": "docker-compose up -d"
}
